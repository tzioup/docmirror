# DocMirror Configuration

# Output directory for mirrored docs (default: ./output)
DOCMIRROR_OUTPUT=./output

# Jina Reader API key — 500 RPM (vs 20 RPM without key). Free tier, 10M tokens.
JINA_API_KEY=your_jina_api_key_here

# Firecrawl API key — used for --filter search and as last-resort discovery
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- LLM Configuration (for --condense) ---

# API key for the LLM provider. Set once, used for all condense runs.
# Falls back to ANTHROPIC_API_KEY for backwards compatibility.
DOCMIRROR_LLM_API_KEY=your_api_key_here

# Base URL for the LLM API. Determines the wire format:
#   - Contains "anthropic.com" → Anthropic Messages API format
#   - Anything else → OpenAI Chat Completions format (works with OpenAI, Groq, Together, Fireworks, Mistral, ollama, etc.)
# Default (unset): https://api.anthropic.com
#
# Examples:
#   DOCMIRROR_LLM_BASE_URL=https://api.openai.com/v1          # OpenAI
#   DOCMIRROR_LLM_BASE_URL=https://api.groq.com/openai/v1     # Groq
#   DOCMIRROR_LLM_BASE_URL=http://localhost:11434/v1           # ollama
#   DOCMIRROR_LLM_BASE_URL=https://api.together.xyz/v1         # Together
DOCMIRROR_LLM_BASE_URL=

# Model ID for condensing. Default: haiku (resolved to claude-haiku-4-5-20251001).
# Set to any model your provider supports (e.g., gpt-4o-mini, llama-3.1-8b-instant).
# Shortcuts "haiku" and "sonnet" resolve to Anthropic model IDs.
DOCMIRROR_LLM_MODEL=haiku

# Legacy — still works, but DOCMIRROR_LLM_API_KEY takes precedence.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
