{
  "name": "docmirror",
  "version": "1.0.0",
  "description": "Turn a doc site URL into a clean markdown corpus optimized for LLM context windows",
  "type": "module",
  "bin": {
    "docmirror": "./docmirror.ts"
  },
  "scripts": {
    "start": "bun run docmirror.ts",
    "help": "bun run docmirror.ts --help",
    "check": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^13.1.0",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.8.0"
  }
}
